<Window x:Class="CifarInterface.MainWindow"
		xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d"
		Title="Tiny ImageNet Classification Console"
		Height="820"
		Width="940"
		MinHeight="760"
		MinWidth="820"
		WindowStartupLocation="CenterScreen"
		ResizeMode="CanResize"
		Background="#26343D"
		FontFamily="Consolas"
		TextOptions.TextFormattingMode="Display"
		UseLayoutRounding="True">

	<Window.Resources>
		<!-- Early workstation palette: warm enclosure, blue identity band, black terminal. -->
		<SolidColorBrush x:Key="Case" Color="#D8D4BE" />
		<SolidColorBrush x:Key="Panel" Color="#F2EEDC" />
		<SolidColorBrush x:Key="PanelShade" Color="#C8C3AC" />
		<SolidColorBrush x:Key="Ink" Color="#11191D" />
		<SolidColorBrush x:Key="MutedInk" Color="#4D595E" />
		<SolidColorBrush x:Key="Navy" Color="#071D33" />
		<SolidColorBrush x:Key="Blue" Color="#006699" />
		<SolidColorBrush x:Key="BrightBlue" Color="#00A4D6" />
		<SolidColorBrush x:Key="Terminal" Color="#081014" />
		<SolidColorBrush x:Key="TerminalText" Color="#7DE2EA" />
		<SolidColorBrush x:Key="Amber" Color="#FFD452" />
		<SolidColorBrush x:Key="Rule" Color="#657278" />

		<Style x:Key="MicroLabel" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Foreground" Value="{StaticResource MutedInk}" />
		</Style>

		<Style x:Key="SectionTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Foreground" Value="{StaticResource Ink}" />
		</Style>

		<Style x:Key="TerminalButton" TargetType="Button">
			<Setter Property="Height" Value="48" />
			<Setter Property="Padding" Value="16,10" />
			<Setter Property="Background" Value="{StaticResource Panel}" />
			<Setter Property="Foreground" Value="{StaticResource Ink}" />
			<Setter Property="BorderBrush" Value="{StaticResource Ink}" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="FontFamily" Value="Consolas" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Grid>
							<Border Background="{StaticResource Ink}" Margin="4,4,0,0" />
							<Border x:Name="Face"
									Margin="0,0,4,4"
									Background="{TemplateBinding Background}"
									BorderBrush="{TemplateBinding BorderBrush}"
									BorderThickness="{TemplateBinding BorderThickness}"
									Padding="{TemplateBinding Padding}">
								<ContentPresenter HorizontalAlignment="Center"
												  VerticalAlignment="Center"
												  RecognizesAccessKey="True" />
							</Border>
						</Grid>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Face" Property="Background" Value="#FFFFFF" />
								<Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource Blue}" />
								<Setter Property="Foreground" Value="{StaticResource Ink}" />
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="Face" Property="Margin" Value="4,4,0,0" />
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="Face" Property="BorderBrush" Value="{StaticResource BrightBlue}" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="Face" Property="Background" Value="{StaticResource PanelShade}" />
								<Setter Property="Foreground" Value="#70777A" />
								<Setter Property="Cursor" Value="Arrow" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="ExecuteButton" TargetType="Button" BasedOn="{StaticResource TerminalButton}">
			<Setter Property="Height" Value="54" />
			<Setter Property="Background" Value="{StaticResource Blue}" />
			<Setter Property="Foreground" Value="White" />
			<Setter Property="BorderBrush" Value="{StaticResource Ink}" />
			<Setter Property="FontSize" Value="13" />
		</Style>

		<Style TargetType="TextBox">
			<Setter Property="Height" Value="46" />
			<Setter Property="Padding" Value="12,10" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Background" Value="#FFFDF1" />
			<Setter Property="Foreground" Value="{StaticResource Ink}" />
			<Setter Property="BorderBrush" Value="{StaticResource Ink}" />
			<Setter Property="BorderThickness" Value="2" />
			<Setter Property="CaretBrush" Value="{StaticResource Blue}" />
			<Setter Property="FontFamily" Value="Consolas" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FocusVisualStyle" Value="{x:Null}" />
			<Style.Triggers>
				<Trigger Property="IsKeyboardFocused" Value="True">
					<Setter Property="BorderBrush" Value="{StaticResource BrightBlue}" />
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="EmptyPreviewHint" TargetType="TextBlock">
			<Setter Property="Visibility" Value="Collapsed" />
			<Setter Property="FontSize" Value="12" />
			<Setter Property="Foreground" Value="{StaticResource TerminalText}" />
			<Setter Property="TextAlignment" Value="Center" />
			<Style.Triggers>
				<DataTrigger Binding="{Binding Source, ElementName=ImgPreview}" Value="{x:Null}">
					<Setter Property="Visibility" Value="Visible" />
				</DataTrigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<Grid Margin="22">
		<!-- Offset rear edge gives the window the weight of a physical control panel. -->
		<Border Background="#0A1115" Margin="7,7,0,0" />

		<Border Margin="0,0,7,7"
				Background="{StaticResource Case}"
				BorderBrush="#0A1115"
				BorderThickness="3">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="92" />
					<RowDefinition Height="42" />
					<RowDefinition Height="*" />
					<RowDefinition Height="34" />
				</Grid.RowDefinitions>

				<!-- Identity band -->
				<Border Grid.Row="0" Background="{StaticResource Navy}" Padding="24,16">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="88" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>

						<!-- A striped data mark inspired by early computing identity systems. -->
						<StackPanel Grid.Column="0" VerticalAlignment="Center" Width="62">
							<Rectangle Height="5" Fill="{StaticResource BrightBlue}" Margin="0,0,0,3" />
							<Rectangle Height="5" Fill="{StaticResource BrightBlue}" Margin="6,0,0,3" />
							<Rectangle Height="5" Fill="{StaticResource BrightBlue}" Margin="12,0,0,3" />
							<Rectangle Height="5" Fill="{StaticResource BrightBlue}" Margin="18,0,0,3" />
							<Rectangle Height="5" Fill="{StaticResource BrightBlue}" Margin="24,0,0,0" />
						</StackPanel>

						<StackPanel Grid.Column="1" VerticalAlignment="Center">
							<TextBlock Text="TINY IMAGENET"
									   Foreground="White"
									   FontSize="26"
									   FontWeight="Bold" />
							<TextBlock Text="VISUAL CLASSIFICATION CONSOLE"
									   Margin="1,4,0,0"
									   Foreground="{StaticResource BrightBlue}"
									   FontSize="11" />
						</StackPanel>

						<StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
							<TextBlock Text="MODEL / TIMG-200" Foreground="#B8CED8" FontSize="10" TextAlignment="Right" />
							<TextBlock Text="64 x 64 RGB" Margin="0,5,0,0" Foreground="White" FontSize="12" FontWeight="Bold" TextAlignment="Right" />
						</StackPanel>
					</Grid>
				</Border>

				<!-- Machine status strip -->
				<Border Grid.Row="1" Background="{StaticResource Ink}" BorderBrush="#000000" BorderThickness="0,1">
					<Grid Margin="24,0">
						<TextBlock Text="SYS.VISION / 200 OBJECT CLASSES / INPUT NORMALIZED TO 64 x 64"
								   Foreground="#D6D9CE"
								   FontSize="10"
								   VerticalAlignment="Center" />
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
							<Rectangle Width="7" Height="7" Fill="{StaticResource Amber}" Margin="0,0,8,0" />
							<TextBlock Text="READY" Foreground="{StaticResource Amber}" FontSize="10" FontWeight="Bold" />
						</StackPanel>
					</Grid>
				</Border>

				<Grid Grid.Row="2" Margin="24">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="300" />
						<ColumnDefinition Width="25" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<!-- Input control bank -->
					<Grid Grid.Column="0">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<StackPanel Grid.Row="0">
							<TextBlock Style="{StaticResource SectionTitle}" Text="01 / IMAGE SOURCE" />
							<Border Height="3" Background="{StaticResource Blue}" Margin="0,8,0,18" />

							<TextBlock Style="{StaticResource MicroLabel}" Text="LOCAL MEDIA" Margin="0,0,0,7" />
							<Button x:Name="BtnPickFile"
									Style="{StaticResource TerminalButton}"
									Content="[ BROWSE IMAGE FILE ]"
									AutomationProperties.Name="Browse image file"
									Click="BtnPickFile_Click" />

							<Grid Margin="0,20,0,16">
								<Border Height="1" Background="{StaticResource Rule}" VerticalAlignment="Center" />
								<Border Background="{StaticResource Case}" Padding="9,1" HorizontalAlignment="Center">
									<TextBlock Text="OR" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedInk}" />
								</Border>
							</Grid>

							<TextBlock Style="{StaticResource MicroLabel}" Text="REMOTE IMAGE ADDRESS" Margin="0,0,0,7" />
							<TextBox x:Name="TxtUrl"
									 Text="Or paste an image URL here"
									 Foreground="Gray"
									 AutomationProperties.Name="Remote image URL"
									 GotFocus="TextUrlFocused"
									 LostFocus="TextUrlUnfocused"
									 TextChanged="TxtUrlType" />
						</StackPanel>

						<Border Grid.Row="2"
								Margin="0,24,0,0"
								Background="#E5E0CB"
								BorderBrush="{StaticResource Rule}"
								BorderThickness="1"
								Padding="13">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<StackPanel>
									<TextBlock Text="DATASET PROFILE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedInk}" />
									<TextBlock Text="TINY IMAGENET" Margin="0,6,0,0" FontSize="12" FontWeight="Bold" />
								</StackPanel>
								<StackPanel Grid.Column="1">
									<TextBlock Text="CLASSES" FontSize="9" Foreground="{StaticResource MutedInk}" HorizontalAlignment="Right" />
									<TextBlock Text="200" FontSize="21" FontWeight="Bold" Foreground="{StaticResource Blue}" HorizontalAlignment="Right" />
								</StackPanel>
							</Grid>
						</Border>

						<Button Grid.Row="4"
								x:Name="BtnClassify"
								Style="{StaticResource ExecuteButton}"
								Content="RUN CLASSIFICATION  &gt;"
								AutomationProperties.Name="Run Tiny ImageNet classification"
								Click="BtnClassify_Click" />
					</Grid>

					<Border Grid.Column="1"
							Width="1"
							Background="#8A928F"
							HorizontalAlignment="Center" />

					<!-- Image monitor and prediction terminal -->
					<Grid Grid.Column="2">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<StackPanel Grid.Row="0">
							<TextBlock Style="{StaticResource SectionTitle}" Text="02 / IMAGE BUFFER" />
							<Border Height="3" Background="{StaticResource Blue}" Margin="0,8,0,18" />
						</StackPanel>

						<Border Grid.Row="1"
								Background="#0B1418"
								BorderBrush="{StaticResource Ink}"
								BorderThickness="4"
								Padding="14"
								MinHeight="285">
							<Grid>
								<!-- Fine scan lines keep the empty monitor from feeling flat. -->
								<Grid Opacity="0.13" IsHitTestVisible="False">
									<Grid.Background>
										<LinearGradientBrush StartPoint="0,0" EndPoint="0,4" SpreadMethod="Repeat" MappingMode="Absolute">
											<GradientStop Color="#49C9D3" Offset="0" />
											<GradientStop Color="Transparent" Offset="0.35" />
										</LinearGradientBrush>
									</Grid.Background>
								</Grid>
								<Image x:Name="ImgPreview"
									   Margin="16"
									   Stretch="Uniform"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center" />
								<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
									<TextBlock Style="{StaticResource EmptyPreviewHint}" Text="+----------------------+" />
									<TextBlock Style="{StaticResource EmptyPreviewHint}" Text="|  AWAITING IMAGE ...  |" Margin="0,5" />
									<TextBlock Style="{StaticResource EmptyPreviewHint}" Text="+----------------------+" />
									<TextBlock Style="{StaticResource EmptyPreviewHint}"
											   Text="SOURCE BUFFER: EMPTY"
											   Foreground="#53949A"
											   FontSize="9"
											   Margin="0,12,0,0" />
								</StackPanel>

								<Border BorderBrush="#31525A" BorderThickness="1" Margin="5" />
								<TextBlock Text="64 PX"
										   Foreground="#5C858C"
										   FontSize="9"
										   HorizontalAlignment="Right"
										   VerticalAlignment="Bottom"
										   Margin="0,0,10,7" />
							</Grid>
						</Border>

						<Border Grid.Row="2"
								Margin="0,18,0,0"
								Background="{StaticResource Terminal}"
								BorderBrush="{StaticResource Ink}"
								BorderThickness="3"
								Padding="15,12">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="72" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<StackPanel>
									<TextBlock Text="OUTPUT" Foreground="{StaticResource Amber}" FontSize="10" FontWeight="Bold" />
									<TextBlock Text="TOP-5 MATCHES" Margin="0,6,0,0" Foreground="#688087" FontSize="8" />
								</StackPanel>
								<TextBlock Grid.Column="1"
										   x:Name="TxtResult"
										   Text="STANDBY"
										   MinHeight="30"
										   Foreground="{StaticResource TerminalText}"
										   FontSize="14"
										   FontWeight="Bold"
										   TextWrapping="Wrap"
										   VerticalAlignment="Center" />
							</Grid>
						</Border>
					</Grid>
				</Grid>

				<Border Grid.Row="3" Background="#B9B49E" BorderBrush="#8E8977" BorderThickness="0,1,0,0">
					<Grid Margin="24,0">
						<TextBlock Text="TIMG CONSOLE  /  BUILD 1.0" FontSize="9" Foreground="#394247" VerticalAlignment="Center" />
						<TextBlock Text="200-WAY INFERENCE" FontSize="9" FontWeight="Bold" Foreground="#394247" HorizontalAlignment="Right" VerticalAlignment="Center" />
					</Grid>
				</Border>
			</Grid>
		</Border>
	</Grid>
</Window>
